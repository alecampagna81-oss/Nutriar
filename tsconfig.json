{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    },
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "server",
    "web/src",
    "shared",
    "tests",
    "scripts"
  ],
  "exclude": [
    "web/dist"
  ]
}