# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=production
APP_NAME=NutriAR
APP_URL=https://tu-dominio.example
PORT=3000
# postgres://usuario:clave@host:5432/base
DATABASE_URL=
# Mínimo 32 caracteres aleatorios: openssl rand -hex 32
SESSION_SECRET=
# Carpeta privada para fotos y documentos (fuera de carpetas públicas)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Detrás de un proxy HTTPS (Caddy, Nginx, Render, etc.)
TRUST_PROXY=1
SECURE_COOKIES=1
# Registro abierto de profesionales (0 en producción; las cuentas se crean con scripts/create-professional.ts)
ALLOW_PROFESSIONAL_SIGNUP=0
# Muestra las credenciales de demostración en la pantalla de ingreso. Solo en entornos de demo.
DEMO_MODE=0
# Correo (opcional). Sin esto, las invitaciones se comparten copiando el enlace.
# Ejemplo: smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
MAIL_FROM=
# Solo para docker-compose
POSTGRES_PASSWORD=
# Carga idempotente del catálogo común al arrancar (1 por defecto)
SEED_CATALOG_ON_START=1
# Con DEMO_MODE=1: crear las cuentas ficticias si no existen (solo entornos de prueba)
SEED_DEMO_IF_EMPTY=0
